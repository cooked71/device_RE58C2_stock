From 2b9b4a8d1234567890abcdef1234567890abcdef Mon Sep 17 00:00:00 2001
From: YourName <you@example.com>
Date: Sun, 17 Aug 2025 21:40:00 +0200
Subject: [PATCH] soong: Map BOARD_SEPOLICY_VERS 33 to 202404 for A13 vendors

Some Android 13 vendor images report BOARD_SEPOLICY_VERS=33,
while AOSP expects 202404. Map 33 → 202404 internally to avoid
assemble_vintf errors.

---
 build/soong/android/config.go | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/build/soong/android/config.go b/build/soong/android/config.go
index 3f28b8a..abcd123 100644
--- a/build/soong/android/config.go
+++ b/build/soong/android/config.go
@@ -1330,6 +1330,12 @@ func (c *config) VendorApiLevel() int {
        vendorApiLevel, _ := strconv.Atoi(c.VendorApiLevelRaw())
 
+       // HACK: Treat sepolicy level 33 as 202404
+       // Needed for devices with Android 13 vendor blobs
+       if vendorApiLevel == 33 {
+               vendorApiLevel = 202404
+       }
+
        if vendorApiLevel < 202404 || vendorApiLevel%100 != 4 {
                return vendorApiLevel
        }
-- 
