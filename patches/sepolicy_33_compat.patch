From 1c7f7a72a0c1d2e8c789e58c1f7f3cbe3bbcf2a3 Mon Sep 17 00:00:00 2001
From: YourName <you@example.com>
Date: Sun, 17 Aug 2025 23:59:00 +0200
Subject: [PATCH] soong: map BOARD_SEPOLICY_VERS 33 to 202404 for A13 vendor

Some vendor images (Android 13) expose BOARD_SEPOLICY_VERS=33,
while AOSP expects 202404. This patch remaps 33 -> 202404
to prevent assemble_vintf from failing.

---

diff --git a/build/soong/android/config.go b/build/soong/android/config.go
index 3f28b8a..b12fa55 100644
--- a/build/soong/android/config.go
+++ b/build/soong/android/config.go
@@ -1341,6 +1341,11 @@ func (c *config) VendorApiLevel() string {
        vendorApiLevel, err := strconv.Atoi(c.VendorApiLevelRaw())
        if err != nil {
                panic(fmt.Errorf("Cannot parse vendor API level %s to an integer: %s",
                        c.VendorApiLevelRaw(), err))
        }
+
+       // HACK: Treat legacy sepolicy level 33 as equivalent to 202404
+       // Needed for devices shipping Android 13 vendor blobs
+       if vendorApiLevel == 33 {
+               return "202404"
+       }
 
        if vendorApiLevel < 202404 || vendorApiLevel%100 != 4 {
                return c.VendorApiLevelRaw()
